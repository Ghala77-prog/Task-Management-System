@page "/TaskItems/Details/{id:int}"
@model TaskManager.Pages.TaskItems.DetailsModel
@{
    ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>

<hr />
<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.TaskItem.Title</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.TaskItem.Description</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.TaskItem.Status</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.TaskItem.Priority</dd>

    <dt class="col-sm-3">Due Date</dt>
    <dd class="col-sm-9">@Model.TaskItem.DueDate</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.TaskItem.CreatedAt</dd>
</dl>

<div class="mt-3">
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.TaskItem.Id">Edit</a>
    <a class="btn btn-secondary" href="/Index">Back</a>

</div>
