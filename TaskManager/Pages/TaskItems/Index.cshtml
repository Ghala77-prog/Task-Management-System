@page
@model TaskManager.Pages.TaskItems.IndexModel

@{
    ViewData["Title"] = "My Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>My Tasks</h1>
        <p class="text-muted">Manage and track your tasks.</p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Add Task
    </a>
</div>


<form method="get" class="mb-4">
    <div class="input-group">
        <input asp-for="SearchString"
               class="form-control"
               placeholder="Search tasks..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (Model.TaskItem.Any())
{
    <div class="row g-4">

        @foreach (var item in Model.TaskItem)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Title
                        </h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <p>
                            <strong>Status:</strong>
                            @item.Status
                        </p>

                        <p class="text-muted">
                            Created: @item.CreatedAt.ToString("dd/MM/yyyy")
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a asp-page="./Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <a asp-page="./Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-secondary">
                            Details
                        </a>

                        <a asp-page="./Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="text-center py-5">
        <h4>No tasks found</h4>
        <p class="text-muted">
            You don't have any tasks yet.
        </p>

        <a asp-page="Create" class="btn btn-primary">
            Create Your First Task
        </a>
    </div>
}