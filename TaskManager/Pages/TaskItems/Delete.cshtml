@page "/TaskItems/Delete/{id:int}"
@model TaskManager.Pages.TaskItems.DeleteModel

@{
    ViewData["Title"] = "Delete Task";
}

<h1>Delete Task</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this task?
</div>

<hr />
<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.TaskItem.Title</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.TaskItem.Description</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.TaskItem.Status</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.TaskItem.Priority</dd>

    <dt class="col-sm-3">Due Date</dt>
    <dd class="col-sm-9">@Model.TaskItem.DueDate</dd>
</dl>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="TaskItem.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" href="/Index">Back</a>


</form>
